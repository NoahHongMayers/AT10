<!DOCTYPE html>
<html>

<%- include('../partials/head.ejs') %>

    <body>

        <%- include('../partials/header.ejs') %>

            <h1>Alarm</h1>

            <h2 id="timer"></h2>
            <div id="alarmMessage"></div>

            <form onsubmit="return false;">
                <label for="alarm">Alarm time:</label>
                <input type="time" id="alarm">
                <button type="button" id="saveAlarm">Save</button>
            </form>

            <%- include('../partials/footer.ejs') %>

                <script src="/socket.io/socket.io.js"></script>
                <script type="text/javascript"
                    src="http://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

                <script>
                    var socket = io.connect('http://localhost:8080');// Establish a connection to the Socket.IO server running on localhost at port 8080
                    var alarmHour = null;
                    var alarmMinutes = null;

                    $(function () {// Wait for the DOM to be fully loaded before executing the code
                        function Clock() {
                            var date = new Date();
                            var minutes = date.getMinutes();
                            var hours = date.getHours();
                            var seconds = date.getSeconds();
                            var h = hours + ":" + minutes + ":" + seconds;
                            $('#timer').text(h);

                            if(minutes = alarmMinutes && hours == alarmHour && seconds == 0) {
                                alert('Alarm! The time is ' + h);
                            }
                        }
                        Clock();
                        setInterval(Clock, 1000);

                        $('#saveAlarm').click(function () {// When the "Save" button is clicked,
                            socket.emit('message', $('#alarm').val());//emit a 'message' event to the server with the value of the alarm
                            $('#alarmMessage').text('You set the Alarm for: ' + $('#alarm').val());//display the set alarm in alarmMessage
                            parts = $('#alarm').val().split(':');
                            alarmHour = parts[0];
                            alarmMinutes = parts[1];
                        });

                        socket.on('message', function (message) {//onMessage
                            $('#alarmMessage').text('Another client has set an alarm for: ' + message);//display the message received from the server in alarmMessage
                            var parts = message.split(':');
                            alarmHour = parts[0];
                            alarmMinutes = parts[1];


                        });
                    });
                </script>
    </body>

</html>